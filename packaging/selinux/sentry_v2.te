policy_module(sentry_v2, 0.2.3)

# Each rule says which part of the daemon needs it. The rules for paths the
# integration suite exercises name the test; scripts/itest.sh runs the suite
# with this module enforcing and fails on any sentry_v2_t denial.

########################################
#
# Declarations
#

type sentry_v2_t;
type sentry_v2_exec_t;
init_daemon_domain(sentry_v2_t, sentry_v2_exec_t)
# The unit sets NoNewPrivileges=yes, and on EL10 init_daemon_domain does not
# grant the nnp_transition that systemd then needs to enter the domain.
init_nnp_daemon_domain(sentry_v2_t)

type sentry_v2_conf_t;
files_config_file(sentry_v2_conf_t)

type sentry_v2_var_lib_t;
files_type(sentry_v2_var_lib_t)

type sentry_v2_var_run_t;
files_pid_file(sentry_v2_var_run_t)

type sentry_v2_unit_file_t;
systemd_unit_file(sentry_v2_unit_file_t)

# The metrics listener's port, 9787. The selinux subpackage labels it with
# semanage in %post; label any other configured port the same way.
type sentry_v2_metrics_port_t;
corenet_port(sentry_v2_metrics_port_t)

########################################
#
# Local policy
#

# The one capability left in CapabilityBoundingSet: joining the audit
# multicast group (collectors/audit.py, test_audit_collector_uses_netlink).
allow sentry_v2_t self:capability2 audit_read;
# Thread pool sizing for asyncio.to_thread (sinks, spool). Python 3.12 uses
# os.cpu_count(), and glibc may call sched_getaffinity behind it; the suite
# will show whether this is ever hit.
allow sentry_v2_t self:process getsched;
# sd_notify and journal logging (dgram); the control socket and asyncio's
# self-pipe, which is a socketpair (stream).
allow sentry_v2_t self:unix_dgram_socket create_socket_perms;
allow sentry_v2_t self:unix_stream_socket { create_stream_socket_perms connectto };
# Outbound sinks and the optional metrics listener.
allow sentry_v2_t self:tcp_socket create_stream_socket_perms;
allow sentry_v2_t self:udp_socket create_socket_perms;

# AVC collector: AF_NETLINK/NETLINK_AUDIT socket bound to the multicast group.
allow sentry_v2_t self:netlink_audit_socket { create bind read getattr getopt setopt nlmsg_read nlmsg_readpriv };
# AVC collector fallback: tail /var/log/audit/audit.log when netlink is refused.
logging_read_audit_log(sentry_v2_t)

# Python itself: the interpreter, the stdlib and its C extensions.
corecmd_exec_bin(sentry_v2_t)
libs_use_ld_so(sentry_v2_t)
libs_use_shared_libs(sentry_v2_t)
files_read_usr_files(sentry_v2_t)
miscfiles_read_localization(sentry_v2_t)
dev_read_urand(sentry_v2_t)

# Config loader: /etc/sentry-v2 and policies.d.
read_files_pattern(sentry_v2_t, sentry_v2_conf_t, sentry_v2_conf_t)
list_dirs_pattern(sentry_v2_t, sentry_v2_conf_t, sentry_v2_conf_t)
# Bundle host section (/etc/os-release, /etc/machine-id) and group lookups
# for the control socket's peer checks.
files_read_etc_files(sentry_v2_t)
auth_use_nsswitch(sentry_v2_t)

# Sink secrets given as systemd credentials (LoadCredential=, a relative
# *_file path in the config). systemd mounts /run/credentials/<unit> with
# init_var_run_t files; checked on the host with a webhook hmac_key_file.
# The interface covers every init_var_run_t file (/run/systemd/* too), not
# just credentials; DAC still limits it to files root can read by mode.
init_read_pid_files(sentry_v2_t)

# Action journal, bundles, spool and backups under /var/lib/sentry-v2.
manage_dirs_pattern(sentry_v2_t, sentry_v2_var_lib_t, sentry_v2_var_lib_t)
manage_files_pattern(sentry_v2_t, sentry_v2_var_lib_t, sentry_v2_var_lib_t)

# Control socket /run/sentry-v2/control.sock. systemd creates the state and
# runtime directories themselves, so no file transitions are needed.
manage_sock_files_pattern(sentry_v2_t, sentry_v2_var_run_t, sentry_v2_var_run_t)

# PSI collector: read *.pressure, register triggers by writing to them and
# poll for events; walk the hierarchy to resolve unit cgroups.
fs_list_cgroup_dirs(sentry_v2_t)
fs_rw_cgroup_files(sentry_v2_t)
fs_watch_cgroup_files(sentry_v2_t)

# Journal collector: persistent journal in /var/log/journal, volatile one in
# /run/log/journal; sd-journal maps the files and watches the directories.
logging_read_generic_logs(sentry_v2_t)
logging_read_syslog_pid(sentry_v2_t)
logging_mmap_journal(sentry_v2_t)
logging_watch_journal_dir(sentry_v2_t)
# /var/log/journal itself is var_log_t; sd-journal watches it for new files
# and fstatfs()es each journal's filesystem (test_avc_correlation,
# test_backup_reload: every unit_failed incident comes through here).
logging_watch_generic_log_dirs(sentry_v2_t)
fs_getattr_tmpfs(sentry_v2_t)
fs_getattr_xattr_fs(sentry_v2_t)
# The daemon's own log output.
logging_send_syslog_msg(sentry_v2_t)

# PSI collector and early thaw: /proc/pressure/* for the root cgroup, and the
# access check that tells whether PSI is on (test_psi_throttle,
# test_freeze_replay).
kernel_read_psi(sentry_v2_t)

# Bundle context: /proc/<pid> of the failing unit, /proc/pressure, meminfo.
domain_read_all_domains_state(sentry_v2_t)
kernel_read_system_state(sentry_v2_t)
kernel_read_kernel_sysctls(sentry_v2_t)
dev_read_sysfs(sentry_v2_t)

# systemd over D-Bus: unit properties, SetUnitProperties (throttle),
# FreezeUnit/ThawUnit and ReloadUnit (backup_reload). These cover every unit
# file type; the protected-unit list is enforced by the daemon, not here.
dbus_system_bus_client(sentry_v2_t)
init_dbus_chat(sentry_v2_t)
init_status(sentry_v2_t)
systemd_status_all_unit_files(sentry_v2_t)
systemd_start_all_unit_files(sentry_v2_t)
gen_require(`
	attribute systemd_unit_file_type;
')
# No interface grants these: FreezeUnit is checked as stop, ReloadUnit as reload.
allow sentry_v2_t systemd_unit_file_type:service { stop reload };
# Transient units (systemd-run, scopes) have no unit file to check against,
# so systemd checks them against its own context in the system class:
# SetUnitProperties as start (test_psi_throttle), FreezeUnit and ThawUnit
# as stop (test_freeze_replay).
init_start(sentry_v2_t)
init_stop(sentry_v2_t)
# backup_reload copies the unit fragment and its drop-ins.
systemd_read_unit_files(sentry_v2_t)
# `sentry-v2ctl restore` writes them back through a temporary file and a
# rename in the same directory (test_backup_reload).
systemd_manage_all_unit_files(sentry_v2_t)
# Type=notify readiness and watchdog pings.
init_dgram_send(sentry_v2_t)

# Sinks. Webhook and Splunk HEC over HTTPS (443, or HEC's 8088, which is
# unlabelled), Elastic on 9200, remote syslog on 514/6514.
sysnet_dns_name_resolve(sentry_v2_t)
miscfiles_read_generic_certs(sentry_v2_t)
corenet_tcp_sendrecv_generic_node(sentry_v2_t)
corenet_tcp_connect_http_port(sentry_v2_t)
corenet_tcp_connect_unreserved_ports(sentry_v2_t)
corenet_tcp_connect_wap_wsp_port(sentry_v2_t)
corenet_tcp_connect_syslogd_port(sentry_v2_t)
corenet_tcp_connect_syslog_tls_port(sentry_v2_t)
corenet_udp_send_syslogd_port(sentry_v2_t)

# Optional metrics listener on 127.0.0.1:9787.
corenet_tcp_bind_generic_node(sentry_v2_t)
allow sentry_v2_t sentry_v2_metrics_port_t:tcp_socket name_bind;
