[Unit]
Description=Sentry-v2 pressure, failure and SELinux denial monitor
Documentation=https://github.com/jamesconwaydev/sentry-v2
After=dbus.service systemd-journald.service auditd.service
Wants=dbus.service

[Service]
# SIGHUP reloads; the daemon reports RELOADING=1 and READY=1 around it
Type=notify-reload
NotifyAccess=main
ExecStart=/usr/bin/sentry-v2
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
# Exit status 2 is a configuration the daemon can't load; restarting won't fix it
RestartPreventExitStatus=2
# On stop the daemon rolls back every active throttle and freeze. Each one
# can take 10 attempts: 243s of backoff plus 10 D-Bus timeouts of 10s. The
# retries overlap but D-Bus calls are serialised, so 5 active actions (the
# max_active_actions default) need up to 243s + 5 * 100s = 743s. Raise this
# if you raise max_active_actions.
TimeoutStopSec=780s
# Startup first rolls back whatever a crashed run left active (replay),
# which has the same worst case as a stop. The daemon sends
# EXTEND_TIMEOUT_USEC every 30s while replay runs, so this is a backstop.
TimeoutStartSec=780s

Slice=system.slice
MemoryMin=48M
MemoryMax=192M
OOMScoreAdjust=-900
CPUWeight=1000

StateDirectory=sentry-v2
StateDirectoryMode=0700
# systemd chowns the runtime directory to the service's group at start, so
# the group has to be set here for sentry-v2 members to reach the socket.
# Admins need both groups: sentry-v2 to get through the directory and
# sentry-v2-admin to change anything (usermod -aG sentry-v2,sentry-v2-admin <you>).
Group=sentry-v2
RuntimeDirectory=sentry-v2
RuntimeDirectoryMode=0750
ConfigurationDirectory=sentry-v2
# Secrets can come from systemd credentials instead of files under /etc:
#LoadCredential=webhook-hmac:/etc/sentry-v2/hmac.key

# Runs as root with one capability: CAP_AUDIT_READ, to join the audit
# multicast group where SELinux denials arrive. Everything it reads or
# writes is owned by root, so it needs no DAC override; /proc/<pid>/cgroup
# and status are world-readable, so no CAP_SYS_PTRACE. The integration
# suite was run with each capability dropped in turn (docs/hardening.md).
CapabilityBoundingSet=CAP_AUDIT_READ
NoNewPrivileges=yes
ProtectSystem=strict
# PSI triggers are registered by writing to <cgroup>/*.pressure. The state
# directory is writable through StateDirectory= anyway; it's listed so
# every writable path shows up in one place. `sentry-v2ctl restore` writes
# backed-up unit files and drop-ins back to the two unit directories admins
# edit; a backup_reload `paths` entry elsewhere can be read for the backup
# but has to be restored by hand.
ReadWritePaths=/var/lib/sentry-v2 /sys/fs/cgroup -/etc/systemd/system -/run/systemd/system
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
