policy_module(sentry_test, 1.0.0)

# test_avc_correlation.py: a confined domain that is denied one file. The
# test labels a copy of bash sentry_test_exec_t, runs it as a unit, and
# expects the denial on sentry_test_secret_t to be tied to that unit.

type sentry_test_t;
type sentry_test_exec_t;
init_daemon_domain(sentry_test_t, sentry_test_exec_t)

type sentry_test_secret_t;
files_type(sentry_test_secret_t)

# Enough to run bash and sleep; reading sentry_test_secret_t is not allowed.
corecmd_exec_bin(sentry_test_t)
libs_use_ld_so(sentry_test_t)
libs_use_shared_libs(sentry_test_t)
miscfiles_read_localization(sentry_test_t)
files_read_etc_files(sentry_test_t)
